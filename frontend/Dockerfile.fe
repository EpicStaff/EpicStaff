ARG TARGET=production

# ─── Stage: deps ─────────────────────────────────────────────────────────────
FROM node:24.15.0@sha256:f22d6a1f082c02f292e86929b5b0442ac2e5eaf438a5dea9b1566601c3e05940 AS deps

WORKDIR /app

# --ignore-scripts blocks preinstall/postinstall hooks, the execution vector a
# supply-chain payload uses. Verified safe here: only 6 of 840 locked packages
# declare install scripts and all 6 are dev-only, esbuild resolves its binary
# through platform optionalDependencies rather than its postinstall, and the
# production bundle builds byte-identical with scripts disabled.
# HUSKY=0 is kept because `prepare` also runs outside install (e.g. local runs).
ENV HUSKY=0
# Angular CLI usage analytics: never phone home from a customer build host.
ENV NG_CLI_ANALYTICS=false
COPY package*.json ./
COPY patches ./patches
RUN npm ci --ignore-scripts && npm cache clean --force

# ─── Stage: development ───────────────────────────────────────────────────────
FROM deps AS development

EXPOSE 4200

# Incremental, not `npm ci`: the deps stage already installed, and `npm ci` would wipe
# and refetch node_modules on every container start. This only reconciles what a
# bind-mounted package.json changed. Dropping --force is safe now that the
# compiler-cli/compiler mismatch that needed it is fixed.
CMD ["sh", "-c", "npm install --ignore-scripts && npm run start -- --host 0.0.0.0 --poll=1000"]

# ─── Stage: build ─────────────────────────────────────────────────────────────
FROM deps AS build

COPY . .

RUN npm run build -- --configuration production

# ─── Stage: production ────────────────────────────────────────────────────────
# Pinned to the same multi-arch index digest as the epicstaff-nginx gateway in
# src/docker-compose.yaml.
FROM docker.io/library/nginx:1.31.9-trixie@sha256:08f354a3b44c422021a5c0f5efb3e27f8f90236b5447d3bac4053f5f50ab6760 AS production

COPY --from=build /app/dist/epicstaff-frontend/browser/ /usr/share/nginx/html/

COPY 50x.html /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY entrypoint.sh /entrypoint.sh
# Runs as the image's unprivileged nginx user (uid 101). Files stay root-owned and read-only for it;
# the `user` directive only applies to a root master, and the pid file moves to the /tmp tmpfs.
# Port 80 needs net.ipv4.ip_unprivileged_port_start=0, set in src/docker-compose.yaml.
RUN chmod +x /entrypoint.sh \
 && sed -i -E -e '/^user[[:space:]]/d' -e 's|^pid[[:space:]].*|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
 && grep -q '^pid /tmp/nginx.pid;$' /etc/nginx/nginx.conf \
 && ! grep -q '^user[[:space:]]' /etc/nginx/nginx.conf

# The frontend's own commit for the About dialog. The last layer with content, so only it changes per
# commit; written before USER nginx because the html folder stays root-owned.
ARG EPICSTAFF_GIT_SHA="" EPICSTAFF_COMMIT_DATE=""
RUN printf '{"git_sha":"%s","commit_date":"%s"}\n' "$EPICSTAFF_GIT_SHA" "$EPICSTAFF_COMMIT_DATE" > /usr/share/nginx/html/version.json

USER nginx

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
