ARG TARGET=production

# ─── Stage: deps ─────────────────────────────────────────────────────────────
FROM node:24.15.0 AS deps

WORKDIR /app

# The `prepare` script installs husky git hooks, which need the repo root and a .git
# dir this stage does not have. HUSKY=0 skips just that script, so esbuild's
# postinstall and the native prebuild steps (lmdb, msgpackr-extract, @parcel/watcher)
# still run — `--ignore-scripts` would silently break them.
ENV HUSKY=0

COPY package*.json ./
RUN npm ci && npm cache clean --force

# ─── Stage: development ───────────────────────────────────────────────────────
FROM deps AS development

EXPOSE 4200

# Incremental, not `npm ci`: the deps stage already installed, and `npm ci` would wipe
# and refetch node_modules on every container start. This only reconciles what a
# bind-mounted package.json changed. Dropping --force is safe now that the
# compiler-cli/compiler mismatch that needed it is fixed.
CMD ["sh", "-c", "npm install && npm run start -- --host 0.0.0.0 --poll=1000"]

# ─── Stage: build ─────────────────────────────────────────────────────────────
FROM deps AS build

COPY . .

RUN npm run build -- --configuration production

# ─── Stage: production ────────────────────────────────────────────────────────
FROM docker.io/library/nginx:alpine AS production

COPY --from=build /app/dist/epicstaff-frontend/browser/ /usr/share/nginx/html/

COPY 50x.html /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
