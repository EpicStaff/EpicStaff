{
    "name": "frontend-crewai",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --no-hmr",
        "start:local": "ng serve --no-hmr --configuration local",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "build-mym": "ng build --base-href /epicstaff/",
        "prepare": "cd .. && npx husky frontend/.husky",
        "postinstall": "patch-package",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{ts,html,scss,json}\""
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ],
        "src/**/*.html": [
            "prettier --write"
        ],
        "src/**/*.scss": [
            "prettier --write"
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "19.2.18",
        "@angular/cdk": "19.2.19",
        "@angular/common": "19.2.18",
        "@angular/compiler": "19.2.18",
        "@angular/core": "19.2.18",
        "@angular/forms": "19.2.18",
        "@angular/material": "19.2.19",
        "@angular/platform-browser": "19.2.18",
        "@angular/platform-browser-dynamic": "19.2.18",
        "@angular/router": "19.2.18",
        "@astral-sh/ruff-wasm-web": "0.15.2",
        "@foblex/2d": "1.2.2",
        "@foblex/flow": "18.4.0",
        "@foblex/mediator": "1.1.3",
        "@foblex/platform": "1.0.4",
        "@foblex/utils": "1.1.1",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/roboto": "^5.2.10",
        "@tabler/icons-webfont": "^3.36.1",
        "ag-grid-angular": "33.3.2",
        "ag-grid-community": "33.3.2",
        "docx-preview": "^0.3.7",
        "lodash-es": "4.18.0",
        "mammoth": "1.12.0",
        "monaco-editor": "0.52.2",
        "ngx-image-cropper": "9.1.6",
        "ngx-json-viewer": "3.2.1",
        "ngx-markdown": "19.1.1",
        "ngx-monaco-editor-v2": "19.0.2",
        "papaparse": "^5.5.3",
        "read-excel-file": "^9.2.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "wavtools": "0.1.5",
        "xlsx": "0.18.5",
        "zone.js": "0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.2.0",
        "@angular-eslint/eslint-plugin": "^19.8.1",
        "@angular/cli": "^19.2.0",
        "@angular/compiler-cli": "^19.2.0",
        "@types/jasmine": "~5.1.0",
        "@types/lodash-es": "^4.17.12",
        "@types/papaparse": "^5.5.2",
        "eslint": "^9.39.4",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jasmine-core": "~5.2.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.1.0",
        "lint-staged": "^16.3.3",
        "patch-package": "^8.0.1",
        "prettier": "^3.8.1",
        "typescript": "~5.5.2",
        "typescript-eslint": "^8.57.0"
    }
}
