{
    "name": "epicstaff-frontend",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --no-hmr",
        "start:local": "ng serve --no-hmr --configuration local",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "build-mym": "ng build --base-href /epicstaff/",
        "prepare": "cd .. && npx husky frontend/.husky",
        "lint": "eslint src --max-warnings=0",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ],
        "src/**/*.html": [
            "prettier --write"
        ],
        "src/**/*.scss": [
            "prettier --write"
        ]
    },
    "private": true,
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "dependencies": {
        "@angular/cdk": "22.1.3",
        "@angular/common": "22.1.2",
        "@angular/compiler": "22.1.2",
        "@angular/core": "22.1.2",
        "@angular/forms": "22.1.2",
        "@angular/material": "22.1.3",
        "@angular/platform-browser": "22.1.2",
        "@angular/router": "22.1.2",
        "@astral-sh/ruff-wasm-web": "0.15.2",
        "@foblex/2d": "1.2.2",
        "@foblex/flow": "19.1.6",
        "@foblex/mediator": "1.1.3",
        "@foblex/platform": "1.0.4",
        "@foblex/utils": "1.1.1",
        "@fontsource/inter": "5.2.8",
        "@fontsource/roboto": "5.2.10",
        "ag-grid-angular": "36.1.0",
        "ag-grid-community": "36.1.0",
        "docx-preview": "^0.3.7",
        "jsonc-parser": "3.3.1",
        "marked": "18.0.10",
        "monaco-editor": "0.55.1",
        "ngx-image-cropper": "9.1.6",
        "ngx-markdown": "22.0.0",
        "ngx-monaco-editor-v2": "22.0.4",
        "papaparse": "5.5.3",
        "read-excel-file": "9.2.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "wavtools": "0.1.5",
        "zone.js": "0.16.2"
    },
    "devDependencies": {
        "@angular-eslint/eslint-plugin": "^22.1.0",
        "@angular/build": "22.1.4",
        "@angular/cli": "22.1.4",
        "@angular/compiler-cli": "22.1.2",
        "@tabler/icons-webfont": "3.36.1",
        "@types/json-schema": "^7.0.15",
        "@types/papaparse": "^5.5.2",
        "eslint": "^9.39.4",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^16.3.3",
        "prettier": "3.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "dompurify": "^3.4.14",
        "@xmldom/xmldom": "^0.9.12",
        "fast-uri": "^4.1.4",
        "qs": "^6.16.0"
    }
}
