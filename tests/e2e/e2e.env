# TEST STACK ONLY: never pass this file to a real deployment (it lengthens the JWT
# lifetime, keeps first-setup open over HTTP and turns SSL off).
# Overrides for the end-to-end stack. Pass after src/.env so these values win:
#   --env-file src/.env --env-file tests/e2e/e2e.env

# knowledge_new sends every embedding request to this base URL and ignores the per-model base_url.
KNOWLEDGE_CUSTOM_EMBED_BASE_URL=http://mock-llm:8080/v1

# No active profile (`none` is the project's convention for that): the dev-only mailpit
# container is not started.
COMPOSE_PROFILES=none

# Agent-saved files go to an e2e-only host folder instead of the dev stack's src/savefiles.
# Relative to src/ (the first -f file). Docker creates it on first `up`; the root
# .gitignore already ignores every `savefiles` folder.
CREW_SAVEFILES_PATH=../tests/e2e/savefiles

# Access tokens must outlive a whole run (the default 15m does not): the suite logs in
# once per user because login is throttled, and keeps using those tokens.
DJANGO_JWT_ACCESS_LIFETIME=2h

# The suite creates the first superadmin through the first-setup HTTP endpoint.
DJANGO_FIRST_SETUP_MODE=open

# The suite talks to nginx over plain HTTP on :80.
NGINX_SSL_MODE=off
