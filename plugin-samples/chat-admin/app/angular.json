{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "newProjectRoot": "projects",
    "projects": {
        "chat-admin": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/chat-admin",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": ["@epicstaff/plugin-sdk/storage-shim"],
                        "tsConfig": "tsconfig.app.json",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "styles": ["src/styles.css"]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kB",
                                    "maximumError": "12kB"
                                }
                            ],
                            "outputHashing": "all",
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": false
                                },
                                "fonts": false
                            },
                            "sourceMap": false,
                            "extractLicenses": true
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "port": 4300,
                        "headers": {
                            "Access-Control-Allow-Origin": "*"
                        }
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "chat-admin:build:production"
                        },
                        "development": {
                            "buildTarget": "chat-admin:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    }
}
