# --- Stage 1: Builder ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder

# Wheels only (UV_NO_BUILD=1): no sdist build backend ever runs at install time.
# foundation is the one audited exception: a first-party, pure-Python local path
# dependency with no wheel of its own, carved out via UV_NO_BINARY_PACKAGE below.
RUN pip install --no-cache-dir uv==0.11.21

ENV UV_NO_BUILD=1 \
    UV_NO_BINARY_PACKAGE=foundation \
    UV_PROJECT_ENVIRONMENT=/app/src/.venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv_cache \
    UV_COMPILE_BYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src/auditor

COPY ./auditor/pyproject.toml ./auditor/uv.lock ./
# foundation is a local path dependency ("../foundation" from /app/src/auditor resolves
# to /app/src/foundation), so its source must exist before uv sync installs it.
COPY ./foundation /app/src/foundation

RUN uv sync --frozen --no-install-project --all-groups --no-group dev

COPY ./auditor /app/src/auditor
COPY ./shared /app/src/shared

RUN chmod +x /app/src/auditor/entrypoint.sh

# --- Stage 2: Runtime ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

COPY --from=builder /app /app

# Code and venv stay root-owned (read-only for the runtime user); only the
# export directory (AUDITOR_EXPORT_DATA_DIR) is writable.
RUN groupadd --system --gid 1000 app \
 && useradd --system --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app \
 && mkdir -p /app/export_data \
 && chown app:app /app/export_data

ENV PATH="/app/src/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src/auditor

USER app

EXPOSE 8060

CMD ["./entrypoint.sh"]
