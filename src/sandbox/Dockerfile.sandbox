# --- Stage 1: Builder ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache \
    POETRY_REQUESTS_TIMEOUT=100 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src

RUN apt-get update && apt-get install -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install updated pip, setuptools, wheel and poetry
RUN pip install --upgrade pip setuptools wheel poetry

# Enable installing via setuptools for legacy packages
ENV PEP517_BUILD_BACKEND=setuptools.build_meta

# Copy lockfiles first (better layer caching)
COPY ./sandbox/pyproject.toml ./sandbox/poetry.lock ./

# Install dependencies inside project .venv
RUN poetry install --no-ansi --no-root

# Copy application source
COPY ./sandbox /app/src/sandbox
COPY ./shared /app/src/shared

# --- Stage 2: Runtime ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

# git is required by the Enter/Exit Worktree Tools (EST-3285 Phase 3) — the
# image previously shipped without it.
RUN apt-get update && apt-get install -y ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for runtime (mirrors agent/Dockerfile.agent). Declared
# before the COPY below so ownership can be assigned during the copy — a
# separate `chown -R /app` would duplicate the whole tree into a second layer.
RUN groupadd --system --gid 1000 app \
 && useradd  --system --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

# Copy built app from builder
COPY --from=builder --chown=app:app /app /app

# Add virtualenv to PATH
ENV PATH="/app/src/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY ./docker/entrypoint-nonroot.sh /usr/local/bin/entrypoint-nonroot.sh
RUN chmod +x /usr/local/bin/entrypoint-nonroot.sh

# Pre-create the runtime dirs so a *fresh* named volume inherits app ownership,
# and hand the whole tree to the app user (pip/venv writes live under here).
RUN mkdir -p /app/src/sandbox/venvs /app/src/sandbox/executions /app/src/sandbox/savefiles \
 && chown app:app /app/src/sandbox/venvs /app/src/sandbox/executions /app/src/sandbox/savefiles

# HOME must be writable: pip and venv write caches there.
ENV HOME=/home/app \
    NONROOT_CHOWN_PATHS="/home/app \${BASE_VENV_PATH:-/app/src/sandbox/venvs} \${OUTPUT_PATH:-/app/src/sandbox/executions} \
        /app/src/shared/epicstaff_secrets/epicstaff_secrets.egg-info /app/src/shared/epicstaff_secrets/build \
        /app/src/shared/epicstaff_storage/epicstaff_storage.egg-info /app/src/shared/epicstaff_storage/build" \
    NONROOT_ADAPT_PATHS="\${CONTAINER_SAVEFILES_PATH:-/app/src/sandbox/savefiles}"

WORKDIR /app/src/sandbox

ENTRYPOINT ["/usr/local/bin/entrypoint-nonroot.sh"]

# Run sandbox module
CMD ["python", "main.py"]