# The routes a webhook tunnel carries, included in EpicStaff's own server and in the tunnel listener
# (default.conf.template), so the two cannot drift: the webhook service (generic webhooks and the
# Telegram callback) and the realtime service's Twilio voice routes (the call webhook and its
# MediaStream WebSocket). Add a route here only when an outside service must call it through the
# tunnel: everything in this file is published on every organization's tunnel URL.

location ^~ /webhooks/ {
    proxy_pass http://webhook_server;
    include /etc/nginx/conf.d/strip-underscore-forwarding-headers.snippet;
    include /etc/nginx/conf.d/cookie-free-upstream.snippet;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
}

location ^~ /voice/ {
    proxy_pass http://realtime_server;
    include /etc/nginx/conf.d/strip-underscore-forwarding-headers.snippet;
    include /etc/nginx/conf.d/cookie-free-upstream.snippet;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location /voice/stream {
    proxy_pass http://realtime_server;
    include /etc/nginx/conf.d/strip-underscore-forwarding-headers.snippet;
    include /etc/nginx/conf.d/cookie-free-upstream.snippet;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
