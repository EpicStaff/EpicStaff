map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend_server {
    server django_app:8000;
}

upstream frontend_server {
    server frontend:${FRONTEND_INTERNAL_PORT};
}

upstream realtime_server {
    server realtime:8050;
}

upstream webhook_server {
    server webhook:${WEBHOOK_PORT};
}

server {
    listen 80;
    client_max_body_size 50M;
    ${SSL_ENABLE} listen 443 ssl;
    
    server_name ${DOMAIN_NAME};

    ${SSL_ENABLE} ssl_certificate /etc/nginx/certs/fullchain.pem; 
    ${SSL_ENABLE} ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ${SSL_ENABLE} ssl_protocols TLSv1.2 TLSv1.3;
    ${SSL_ENABLE} ssl_ciphers HIGH:!aNULL:!MD5;

    # Force TLS when SSL_ENABLE is on. This block serves both :80 and :443, so
    # the redirect is scoped by $scheme instead of a second server block -- a
    # second block on :80 would collide with the listen directive above.
    # If a load balancer terminates TLS in front of nginx, leave SSL_ENABLE off
    # here: $scheme would always be http and this would redirect in a loop.
    ${SSL_ENABLE} if ($scheme = http) { return 301 https://$host$request_uri; }

    # ---- Security response headers --------------------------------------
    # WARNING: nginx inherits add_header into a location only if that location
    # declares no add_header of its own. Adding one to any location below
    # silently drops every header here for that route -- repeat them there if
    # a route ever needs its own.
    #
    # Django's XFrameOptionsMiddleware already sends X-Frame-Options: DENY on
    # proxied responses. Hide it so nginx is the single source of truth and
    # browsers never receive two conflicting values.
    proxy_hide_header X-Frame-Options;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;

    # Report-only: the SPA is built from a separate repository, so this policy
    # has not been verified against it. Violations surface in the browser
    # console; there is no report collector in this stack. Promote to
    # Content-Security-Policy once the console is clean.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'self'; base-uri 'self'" always;

    ${SSL_ENABLE} add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # ---------------------------------------------------------------------

    location / {
        proxy_pass http://frontend_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/run-session/subscribe/ {
        proxy_pass http://backend_server;
        
        proxy_buffering off;
        proxy_cache off;

        proxy_set_header Connection '';
        proxy_http_version 1.1;
        proxy_read_timeout 24h;
        chunked_transfer_encoding on;

        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/ws/ {
        proxy_pass http://backend_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location ~ ^/(api|admin|ht|swagger)(/|$) {
        proxy_pass http://backend_server;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /webhooks/ {
        proxy_pass http://webhook_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location ^~ /voice/ {
        proxy_pass http://realtime_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /voice/stream {
        proxy_pass http://realtime_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /realtime/ {
        proxy_pass http://realtime_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        proxy_pass http://backend_server/static/;
        proxy_set_header Host $host;
    }

    location /media/ {
        proxy_pass http://backend_server/media/;
        proxy_set_header Host $host;
    }
}
