# Sourced by the nginx image's /docker-entrypoint.sh before 20-envsubst-on-templates.sh,
# so the templates see CHAT_ENABLED as exactly `true` or `false`: it names the included
# chat-${CHAT_ENABLED}.snippet. Accepts what Django's env.bool reads as true, plus the
# matching false words; anything else stops the container instead of breaking nginx.
# Keep in step with frontend/entrypoint.sh.
chat_enabled_normalized=$(printf '%s' "${CHAT_ENABLED:-}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
case "$chat_enabled_normalized" in
    1 | y | yes | true | on) export CHAT_ENABLED=true ;;
    0 | n | no | false | off) export CHAT_ENABLED=false ;;
    *)
        echo "CHAT_ENABLED='${CHAT_ENABLED:-}' is not a boolean. Use true or false (also accepted, any case: 1/0, yes/no, y/n, on/off)." >&2
        exit 1
        ;;
esac
unset chat_enabled_normalized
