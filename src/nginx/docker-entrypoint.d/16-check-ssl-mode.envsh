# Sourced by the nginx image's /docker-entrypoint.sh before 20-envsubst-on-templates.sh,
# so the templates see NGINX_SSL_MODE as exactly `on` or `off`: it names the included
# ssl-${NGINX_SSL_MODE}.snippet. With TLS on, a missing or empty certificate file stops the
# container here with a message naming the file, instead of nginx failing on it with an
# OpenSSL error that does not mention the TLS setting.
# >>> env_bool
# Strict boolean environment flag, accepting exactly the values Env.bool accepts
# (src/shared/envtools.py). Copied verbatim into every script that needs it;
# .github/scripts/check_env_conventions.py fails CI if the copies or the values drift.
# Usage: if env_bool NAME [DEFAULT]; then ...; fi
# Returns 0 for true and 1 for false. DEFAULT applies only when NAME is unset.
# An unset NAME without DEFAULT, or any other value, exits the script with 64.
env_bool() {
  eval "env_bool_is_set=\${$1+set}"
  if [ -n "$env_bool_is_set" ]; then
    eval "env_bool_value=\${$1}"
  elif [ $# -ge 2 ]; then
    env_bool_value=$2
  else
    echo "ERROR: environment variable $1 is not set." >&2
    exit 64
  fi
  case "$(printf '%s' "$env_bool_value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')" in
    1|on|t|true|y|yes) return 0 ;;
    0|f|false|n|no|off) return 1 ;;
  esac
  echo "ERROR: environment variable $1='$env_bool_value' is not a boolean. Use one of 1, on, t, true, y, yes for true or 0, f, false, n, no, off for false (case-insensitive)." >&2
  exit 64
}
# <<< env_bool

if env_bool NGINX_SSL_MODE; then
  # The same two paths ssl-on.snippet.template loads.
  for certificate_path in /etc/nginx/certs/fullchain.pem /etc/nginx/certs/privkey.pem; do
    if ! [ -f "$certificate_path" ] || ! [ -s "$certificate_path" ]; then
      echo "ERROR: TLS is enabled (NGINX_SSL_MODE=on) but $certificate_path is missing or empty. Add a certificate as described in docs/setup/ssl.md. Set NGINX_SSL_MODE=off only if TLS is handled by a load balancer in front of nginx." >&2
      exit 1
    fi
  done
  export NGINX_SSL_MODE=on
else
  export NGINX_SSL_MODE=off
fi
