# --- Stage 1: Builder ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache \
    POETRY_REQUESTS_TIMEOUT=100 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    python3-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Install updated pip, setuptools, wheel and poetry
RUN pip install --upgrade pip setuptools wheel poetry

# Enable installing via setuptools for legacy packages
ENV PEP517_BUILD_BACKEND=setuptools.build_meta

# Copy lockfiles first (better layer caching)
COPY ./realtime/pyproject.toml ./realtime/poetry.lock ./

# Install dependencies inside project .venv
RUN poetry install --no-ansi --no-root

# Pre-cache the tiktoken encoding used by the chat-buffer tokenizer
# (utils/tokenizer.py -> tiktoken.encoding_for_model, hardcoded default
# model="gpt-4o" -> o200k_base) so no realtime/voice session downloads the
# BPE file from openaipublic.blob.core.windows.net on first use. Cache dir
# must live under /app since nothing outside it is copied into the runtime
# stage below.
ENV TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken
RUN poetry run python -c "import tiktoken; tiktoken.encoding_for_model('gpt-4o')"

# Copy application source
COPY ./realtime /app/src/realtime
COPY ./shared /app/src/shared

# --- Stage 2: Runtime ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

# libpq-dev are required for psycopg2 https://www.psycopg.org/docs/install.html
RUN apt-get update && apt-get install -y \
    libpq-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy built app from builder
COPY --from=builder /app /app

# Add virtualenv to PATH.
# TIKTOKEN_CACHE_DIR points at the pre-baked cache from the builder stage
# (EST-3245: chat-buffer tokenizer must not fetch from
# openaipublic.blob.core.windows.net at runtime).
ENV PATH="/app/src/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken

WORKDIR /app/src/realtime

# Run module from workdir
CMD ["python", "run_server.py"]