# --- Stage 1: Builder ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder

# Wheels only. UV_NO_BUILD=1 refuses to build source distributions, so no
# sdist's setup.py / PEP 517 backend runs at install time, meaning resolving
# never executes arbitrary Python code. This service has two audited
# exceptions, both carved out via UV_NO_BINARY_PACKAGE below: psycopg2
# publishes no Linux wheel, and graphrag is a local first-party path dependency
# with no wheel of its own -- a service that gains another dependency with no
# Linux wheel will fail the build rather than silently regain source execution.
#
# UV_PYTHON_DOWNLOADS=never is load-bearing: without it uv may fetch its own
# interpreter instead of using the digest-pinned base image above, silently
# defeating that pin.
RUN pip install --no-cache-dir uv==0.11.21

ENV UV_NO_BUILD=1 \
    UV_NO_BINARY_PACKAGE="psycopg2 graphrag" \
    UV_PROJECT_ENVIRONMENT=/app/src/.venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv_cache \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only dependency descriptors first (better layer caching)
COPY ./knowledge/pyproject.toml ./knowledge/uv.lock ./knowledge/.python-version ./

# Copy local libraries before install (required if pyproject.toml references them)
COPY ./knowledge/libraries/ ./libraries

# Install dependencies into /app/src/.venv.
# --all-groups is required: secfloor (and any other non-dev group) is not
# installed by default.
RUN uv sync --frozen --no-install-project --all-groups

# Pre-cache the gpt2 HF tokenizer (chonkie default chunker) and the tiktoken
# encodings actually used at runtime (cl100k_base — GraphRAG's TiktokenTokenizer
# default) into the image, under /app so it survives the COPY --from=builder
# below. Cache dirs must live under /app since nothing outside it is copied
# into the runtime stage.
ENV HF_HOME=/app/.cache/huggingface \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken
RUN /app/src/.venv/bin/python -c "from tokenizers import Tokenizer; Tokenizer.from_pretrained('gpt2')" \
 && /app/src/.venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Copy application source
COPY ./knowledge /app/src/knowledge
COPY ./shared /app/src/shared

# --- Stage 2: Runtime ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

# libpq-dev are required for psycopg2 https://www.psycopg.org/docs/install.html
RUN apt-get update && apt-get install -y libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy built app from builder
COPY --from=builder /app /app

# Add virtualenv to PATH.
# HF_HOME/TIKTOKEN_CACHE_DIR point at the pre-baked caches from the builder
# stage (EST-3245: no default-deploy runtime fetch to huggingface.co or
# openaipublic.blob.core.windows.net). HF_HUB_OFFLINE=1 makes any future
# accidental HF Hub call fail loudly instead of phoning home.
# LITELLM_LOCAL_MODEL_COST_MAP=True: litellm otherwise does a live GET to
# raw.githubusercontent.com on every `import litellm` (confirmed by runtime
# trace, see docs/backend-runtime-fetch-audit.md item 7) — knowledge pulls in
# litellm transitively via the graphrag uv dependency group.
ENV PATH="/app/src/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/huggingface \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken \
    HF_HUB_OFFLINE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True

WORKDIR /app/src/knowledge

# Run module
CMD ["python", "main.py"]