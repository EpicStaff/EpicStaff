# --- Stage 1: Builder ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache \
    POETRY_REQUESTS_TIMEOUT=100 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install updated pip, setuptools, wheel and poetry
RUN pip install --upgrade pip setuptools wheel poetry

# Enable installing via setuptools for legacy packages
ENV PEP517_BUILD_BACKEND=setuptools.build_meta

# Copy lockfiles first (better layer caching)
COPY ./knowledge/pyproject.toml ./knowledge/poetry.lock ./

# Copy local libraries before install (required if pyproject.toml references them)
COPY ./knowledge/libraries/ ./libraries

# Install dependencies inside project .venv
RUN poetry install --no-ansi --no-root

# Pre-cache the gpt2 HF tokenizer (chonkie default chunker) and the tiktoken
# encodings actually used at runtime (cl100k_base — GraphRAG's TiktokenTokenizer
# default) into the image, under /app so it survives the COPY --from=builder
# below. Cache dirs must live under /app since nothing outside it is copied
# into the runtime stage.
ENV HF_HOME=/app/.cache/huggingface \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken
RUN poetry run python -c "from tokenizers import Tokenizer; Tokenizer.from_pretrained('gpt2')" \
    && poetry run python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Copy application source
COPY ./knowledge /app/src/knowledge
COPY ./shared /app/src/shared

# --- Stage 2: Runtime ---
FROM python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

# libpq-dev are required for psycopg2 https://www.psycopg.org/docs/install.html
RUN apt-get update && apt-get install -y libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy built app from builder
COPY --from=builder /app /app

# Add virtualenv to PATH.
# HF_HOME/TIKTOKEN_CACHE_DIR point at the pre-baked caches from the builder
# stage (EST-3245: no default-deploy runtime fetch to huggingface.co or
# openaipublic.blob.core.windows.net). HF_HUB_OFFLINE=1 makes any future
# accidental HF Hub call fail loudly instead of phoning home.
# LITELLM_LOCAL_MODEL_COST_MAP=True: litellm otherwise does a live GET to
# raw.githubusercontent.com on every `import litellm` (confirmed by runtime
# trace, see docs/backend-runtime-fetch-audit.md item 7) — knowledge pulls in
# litellm transitively via the graphrag poetry group.
ENV PATH="/app/src/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/huggingface \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken \
    HF_HUB_OFFLINE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True

# Create non-root user for runtime (mirrors agent/Dockerfile.agent).
RUN groupadd --system --gid 1000 app \
 && useradd  --system --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

COPY ./docker/entrypoint-nonroot.sh /usr/local/bin/entrypoint-nonroot.sh
RUN chmod +x /usr/local/bin/entrypoint-nonroot.sh

# GRAPH_DATA_DIR lives outside /app, so it needs creating and chowning too.
RUN mkdir -p /home/user/root/app/graph_data \
 && chown -R app:app /app /home/user/root/app

ENV HOME=/home/app \
    NONROOT_CHOWN_PATHS="/home/app /home/user/root/app/graph_data"

WORKDIR /app/src/knowledge

ENTRYPOINT ["/usr/local/bin/entrypoint-nonroot.sh"]

# Run module
CMD ["python", "main.py"]