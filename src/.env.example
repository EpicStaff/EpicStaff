
# ==================================================================================================
# EpicStaff environment configuration
# ==================================================================================================
# GENERATED FROM: src\env.yaml
# GENERATED AT: 2026-09-11 13:13:36.048436
#
# Do not edit this file by hand — regenerate it with:
#   python scripts/envtool.py          # production defaults
#   python scripts/envtool.py --dev    # local development defaults
#
# Usage: copy this file to `.env`, then replace every `<enter your value>` marker
# with a real value before running `docker compose up`. Lines commented out as
# `# NAME=<enter your value>` are REQUIRED and have no default — uncomment them and
# set a value. Every uncommented variable already has a working default.

# ==================================================================================================
# Deploy
# ==================================================================================================

# Container image tag for ghcr pulls in non-build deploys. Prod must pin a release tag (webhook
# enforces it); dev builds locally so latest is fine.
IMAGE_TAG=latest

# ==================================================================================================
# Crewdb
# ==================================================================================================

# Postgres superuser for the shared crewdb instance.
# DB_USER=<enter your value>

# Password for the crewdb Postgres superuser.
# DB_PASSWORD=<enter your value>

# Hostname of the Postgres container on the backend network.
DB_HOST=crewdb

# Postgres TCP port.
DB_PORT=5432

# Default database created on first init.
DB_NAME=epicstaff_db

# Postgres data directory inside the container (mounted volume).
PGDATA=/var/lib/postgresql/data/pgdata

# ==================================================================================================
# Redis
# ==================================================================================================

# Redis ACL user used by services to connect.
# REDIS_USER=<enter your value>

# Password for the Redis user.
# REDIS_PASSWORD=<enter your value>

# Hostname of the Redis container.
REDIS_HOST=redis

# Redis TCP port.
REDIS_PORT=6379

# ==================================================================================================
# Minio
# ==================================================================================================

# MinIO root access key.
# MINIO_USER=<enter your value>

# MinIO root secret key.
# MINIO_PASSWORD=<enter your value>

# Hostname of the MinIO container.
MINIO_HOST=minio

# Use HTTPS when talking to MinIO.
MINIO_SSL=False

# MinIO S3 API port.
MINIO_PORT=9000

# MinIO web console port.
MINIO_CONSOLE_PORT=9001

# Bucket used for object storage.
MINIO_BUCKET=epicstaff

# ==================================================================================================
# Django
# ==================================================================================================

# Hostname the django_app service binds/announces on.
DJANGO_HOST=django

# Port the django_app service listens on.
DJANGO_PORT=8000

# Gunicorn worker processes.
DJANGO_SGI_WORKERS=1

# Threads per Gunicorn worker.
DJANGO_SGI_THREADS=4

# Requests a worker handles before it is recycled (memory-leak guard).
DJANGO_SGI_MAX_REQUESTS=1000

# Random spread added to max-requests so workers don't recycle in lockstep.
DJANGO_SGI_MAX_REQUESTS_JITTER=100

# Root log level for django_app.
DJANGO_LOG_LEVEL=INFO

# Django SECRET_KEY for signing sessions and tokens. Required in prod; rotating it invalidates all
# existing sessions and signed values.
# DJANGO_SECRET_KEY=<enter your value>

# Django debug mode. Never enable in production.
DJANGO_DEBUG=False

# Comma-separated hostnames Django will serve (Host header allow-list).
DJANGO_ALLOWED_HOSTS=*

# Server timezone (IANA name, e.g. UTC, Europe/Kyiv).
DJANGO_TIMEZONE=UTC

# Access-token lifetime.
DJANGO_JWT_ACCESS_LIFETIME=15m

# Refresh-token lifetime.
DJANGO_JWT_REFRESH_LIFETIME=7d

# SMTP host. Leave blank together with user/password to fall back to the console email backend
# (reset links printed to stdout).
DJANGO_EMAIL_HOST=none

# SMTP port.
DJANGO_EMAIL_PORT=1025

# SMTP username; blank means unauthenticated relay.
DJANGO_EMAIL_USER=none

# SMTP password; blank means unauthenticated relay.
DJANGO_EMAIL_PASSWORD=none

# Use STARTTLS for SMTP.
DJANGO_EMAIL_USE_TLS=True

# Use implicit SSL for SMTP (mutually exclusive with TLS).
DJANGO_EMAIL_USE_SSL=False

# Default From address for outgoing mail.
DJANGO_DEFAULT_FROM_EMAIL=no-reply@epicstaff.local

# Lifetime of a password-reset token.
DJANGO_PASSWORD_RESET_TOKEN_TTL=15m

# Lifetime of a password-change ticket.
DJANGO_PASSWORD_CHANGE_TICKET_TTL=5m

# Per-IP cap on password-reset requests.
DJANGO_PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour

# Per-IP cap on password-reset confirmations.
DJANGO_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour

# Per-IP cap on login attempts.
DJANGO_LOGIN_THROTTLE_RATE=5/min

# Per-IP cap on token-refresh calls.
DJANGO_TOKEN_REFRESH_THROTTLE_RATE=30/min
DJANGO_NOTIFY_EMAIL_THROTTLE_RATE=10/hour

# Who may create the first superadmin. cli_only: only `manage.py create_superadmin` (safe for
# internet-exposed deploys). open: the first-setup HTTP endpoint is enabled (local dev only).
DJANGO_FIRST_SETUP_MODE=cli_only

# Public base URL of the frontend, used to build links in emails.
# DJANGO_FRONTEND_BASE_URL=<enter your value>

# Frontend route appended to the base URL for reset links.
DJANGO_FRONTEND_PASSWORD_RESET_PATH=/reset-password

# Comma-separated trusted origins for CORS (django_app/realtime/webhook).
# DJANGO_CORS_ALLOWED_ORIGINS=<enter your value>

# Internal system API key for service-to-service calls (superadmin-equivalent, never expires). Use a
# long random string; never expose to end users.
DJANGO_API_KEY=none

# Maximum avatar upload size.
DJANGO_AVATAR_MAX_SIZE=50mb

# Comma-separated allowed avatar image formats.
DJANGO_AVATAR_ALLOWED_FORMATS=JPEG,PNG

# Maximum size of a single uploaded file.
DJANGO_MAX_UPLOAD_FILE_SIZE=50mb

# Maximum total size of one upload request.
DJANGO_MAX_UPLOAD_TOTAL_SIZE=50mb

# Max entries allowed when unpacking an uploaded archive (zip-bomb guard).
DJANGO_MAX_ARCHIVE_ENTRIES=2000

# Max total uncompressed size when unpacking an archive (zip-bomb guard).
DJANGO_MAX_ARCHIVE_UNCOMPRESSED_SIZE=256mb

# glibc malloc arena cap; limits RSS growth from fragmentation.
DJANGO_MALLOC_ARENA_MAX=2

# How often to return freed heap memory to the OS.
DJANGO_MALLOC_TRIM_INTERVAL=60s
DJANGO_API_URL=http://localhost/api/

# ==================================================================================================
# Realtime
# ==================================================================================================

# Hostname the realtime service binds/announces on.
REALTIME_HOST=realtime

# Port the realtime WebSocket service listens on.
REALTIME_PORT=8050
REALTIME_SGI_WORKERS=1

# Postgres role for the realtime service.
# REALTIME_DB_USER=<enter your value>

# Password for the realtime Postgres role.
# REALTIME_DB_PASSWORD=<enter your value>

# Base URL realtime calls to authenticate requests against django_app.
# DJANGO_AUTH_URL=<enter your value>

# Timeout for the auth call to django_app.
DJANGO_AUTH_TIMEOUT=5s

# ==================================================================================================
# Manager
# ==================================================================================================

# Postgres role for the manager service.
# MANAGER_DB_USER=<enter your value>

# Password for the manager Postgres role.
# MANAGER_DB_PASSWORD=<enter your value>

# ==================================================================================================
# Sandbox
# ==================================================================================================

# Hostname the sandbox service binds/announces on.
SANDBOX_HOST=sandbox

# Port the sandbox service listens on.
SANDBOX_PORT=8090

# Directory holding per-execution Python virtualenvs.
SANDBOX_BASE_VENV_PATH=/app/src/sandbox/venvs/

# Directory where code-execution outputs are written.
SANDBOX_OUTPUT_PATH=/app/src/sandbox/executions/

# Replace secret values with [REDACTED] in Python-node output. Disable only for local debugging -
# plaintext credentials then reach results, the SSE stream and logs.
SANDBOX_MASK_SECRET=True

# Directory inside the sandbox container where agent-saved files are written (bind target).
CONTAINER_SAVEFILES_PATH=/app/src/sandbox/savefiles/

# Absolute HOST path bind-mounted into the sandbox for agent-saved files (Docker creates it if
# missing). Machine-specific - override per host.
# CREW_SAVEFILES_PATH=<enter your value>

# Enforce the Landlock filesystem jail around every code execution. Set false only to run on a
# kernel without Landlock support during local debugging: executions then run UNCONFINED. Never use
# false with real data.
SANDBOX_REQUIRE_ISOLATION=True

# Maximum time a single python code execution may run before it is killed. Protects against user
# code that hangs or loops forever.
SANDBOX_EXECUTION_TIMEOUT=5m

# ==================================================================================================
# Webhook
# ==================================================================================================

# Hostname the webhook service binds/announces on.
WEBHOOK_HOST=webhook

# Port the webhook service listens on.
WEBHOOK_PORT=8009

# Tunnel provider used to expose webhooks publicly.
WEBHOOK_TUNNEL=ngrok

# Whether to open a public tunnel for incoming webhooks.
WEBHOOK_USE_TUNNEL=False

# Reserved ngrok domain (used when the tunnel is ngrok).
WEBHOOK_NGROK_DOMAIN=none

# ngrok auth token (used when the tunnel is ngrok).
WEBHOOK_NGROK_AUTHTOKEN=none
WEBHOOK_EMPTY_JSON_PATHS=none

# Root log level for the webhook service.
WEBHOOK_LOG_LEVEL=INFO

# ==================================================================================================
# Frontend
# ==================================================================================================

# Hostname the frontend is served on.
FRONTEND_HOST=localhost

# Port the frontend dev server / container listens on.
FRONTEND_PORT=4200

# Base URL the frontend calls for the REST API (through nginx).
API_URL=http://localhost/api/

# Base URL the frontend calls for the realtime API (through nginx).
REALTIME_API_URL=http://localhost/realtime/

# ==================================================================================================
# Nginx
# ==================================================================================================

# Public domain nginx serves; also used for SSL certs.
NGINX_DOMAIN_NAME=localhost

# SSL toggle via comment hack: `#` disables the SSL server block, empty enables it.
NGINX_SSL_ENABLE=#

# Upstream port nginx proxies the frontend on (frontend container listens on 80).
FRONTEND_INTERNAL_PORT=80

# ==================================================================================================
# Agent
# ==================================================================================================

# Hostname the agent service binds/announces on.
AGENT_HOST=agent

# Port the agent service listens on.
AGENT_PORT=8052

# Log level for the agent service.
AGENT_LOG_LEVEL=INFO

# Redis stream the agent consumes execution requests from.
AGENT_REQUEST_STREAM=agent.requests

# Redis stream the agent publishes results to.
AGENT_RESULT_STREAM=agent.result

# Redis consumer group name for agent workers.
AGENT_CONSUMER_GROUP=agent-executors

# Default retries for a failed agent step.
AGENT_DEFAULT_MAX_RETRIES=5

# Max tool-use iterations per run (the agent loop).
AGENT_DEFAULT_MAX_ITER=25

# Max re-prompts to make the final answer match output_schema (separate from loop iters).
AGENT_SCHEMA_MAX_RETRIES=2

# Drop LLM params a provider doesn't support (e.g. presence/frequency_penalty on Anthropic) instead
# of erroring.
AGENT_DROP_UNSUPPORTED_LLM_PARAMS=True

# Warn (advisory, in response 'warnings') when input context reaches this fraction of the model's
# context window; 0 disables.
AGENT_CONTEXT_WARNING_RATIO=0.8
AGENT_RESULT_TIMEOUT=10s

# ==================================================================================================
# Knowledge
# ==================================================================================================

# Hostname the knowledge service binds/announces on.
KNOWLEDGE_HOST=knowledge

# Port the knowledge service listens on.
KNOWLEDGE_PORT=8100

# Postgres role for the knowledge service (pgvector store).
# KNOWLEDGE_DB_USER=<enter your value>

# Password for the knowledge Postgres role.
# KNOWLEDGE_DB_PASSWORD=<enter your value>

# Max size of a single document accepted for text extraction.
KNOWLEDGE_MAX_EXTRACTION_INPUT_SIZE=50mb

# Max total uncompressed size when extracting an archive.
KNOWLEDGE_MAX_EXTRACTION_UNPACKED_SIZE=256mb

# Max decoded content one document may yield. PDFs declare no unpacked size, so streams are inflated
# up to this cap before layout.
KNOWLEDGE_MAX_EXTRACTION_CONTENT_SIZE=4mb

# Largest HTML file that may be parsed.
KNOWLEDGE_MAX_EXTRACTION_HTML_SIZE=2mb

# Max pages processed per document.
KNOWLEDGE_MAX_EXTRACTION_PAGES=2000

# Directory holding GraphRAG index data (mounted volume).
KNOWLEDGE_GRAPH_DATA_DIR=/home/user/root/app/graph_data

# Extra HTTP headers sent to the embedding provider (JSON); blank for none.
KNOWLEDGE_EMBEDDING_HEADERS=none

# ==================================================================================================
# Crew
# ==================================================================================================

# Hostname the crew service binds/announces on.
CREW_HOST=crew

# Port the crew service listens on.
# CREW_PORT=<enter your value>

# Max flow sessions running concurrently in crew.
CREW_MAX_CONCURRENT_SESSIONS=25

# TTL for remembered task outputs during a flow run.
CREW_REMEMBERED_OUTPUTS_TTL=1h

# Fallback timeout for a RAG search.
DEFAULT_RAG_SEARCH_TIMEOUT=30s

# Timeout for a naive-RAG search.
NAIVE_RAG_SEARCH_TIMEOUT=40s

# Timeout for a GraphRAG search (slower by design).
GRAPH_RAG_SEARCH_TIMEOUT=3m
CREW_LLM_HEADERS=none
CREW_TOKEN_BUDGET=0

# ==================================================================================================
# Communication
# ==================================================================================================
CODE_EXEC_CHANNEL=code_exec_tasks
CODE_RESULT_CHANNEL=code_results
SESSION_EVENT_UPDATE_CHANNEL=session:event:update
SESSION_EVENT_CHANNEL=session:event
SESSION_STATUS_CHANNEL=sessions:session_status
SESSION_SCHEMA_CHANNEL=sessions:schema
SCHEDULE_CHANNEL=schedule_channel
STOP_SESSION_CHANNEL=sessions:stop
KNOWLEDGE_INDEXING_CHANNEL=knowledge:indexing
KNOWLEDGE_DOCUMENT_CHUNK_REQUEST_CHANNEL=knowledge:chunk
KNOWLEDGE_DOCUMENT_CHUNK_RESPONSE_CHANNEL=knowledge:chunk:response
KNOWLEDGE_SEARCH_REQUEST_CHANNEL=knowledge:search:get
KNOWLEDGE_SEARCH_RESPONSE_CHANNEL=knowledge:search:response
GRAPH_MESSAGES_CHANNEL=graph:messages
GRAPH_MESSAGE_UPDATE_CHANNEL=graph:message:update
WEBHOOK_MESSAGE_CHANNEL=webhooks
REQUEST_WEBHOOK_UPDATE_CHANNEL=REQUEST_WEBHOOK_UPDATE_CHANNEL
STORAGE_MUTATION_CHANNEL=storage_mutations

# REVIEW - read by crew & manager; no producer found in repo (may be dead code).
SESSION_TIMEOUT_CHANNEL=sessions:timeout

# REVIEW - read by crew; no producer found in repo (may be dead code).
CREWAI_OUTPUT_CHANNEL=crewai:output

# REVIEW - read by realtime; verify producer/contract.
REALTIME_AGENTS_SCHEMA_CHANNEL=realtime_agents:schema

# Django -> realtime cache invalidation for RealtimeChannel lookup-by-token (per-channel config
# cache).
REALTIME_CHANNELS_INVALIDATE_CHANNEL=realtime_channels:invalidate

# REVIEW - read by knowledge; verify producer/contract.
KNOWLEDGE_SOURCES_CHANNEL=knowledge_sources
