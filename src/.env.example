# GENERATED FROM src/env.yaml - do not edit. Run: python scripts/generate_env.py

# EpicStaff environment configuration.
# Copy to `.env`, fill in the marked secrets, then `docker compose up -d`.
#
# Lines marked CHANGE ME must be set before first run.
# Everything else has sensible defaults that work for a local install.

# Image tag to pull from ghcr.io/epicstaff/*
# Use 'latest' to track main, or pin to a release like v1.0.7
IMAGE_TAG=latest

# ===== SHARED =====

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                          # CHANGE ME (any non-empty string)

# Database configuration
POSTGRES_DB=crew
POSTGRES_PASSWORD=                       # CHANGE ME (postgres superuser password)
PGDATA=/var/lib/postgresql/data
DB_HOST_NAME=crewdb
DB_NAME=crew
DB_PORT=5432
DB_USER=postgres

# Communication
# DEFAULT_PAYLOAD_SIZE_THRESHOLD=        # To change default payload size threshold for all producers
# ==================

# ==== SERVICES ====

# django_app
DEBUG=False
DJANGO_LOG_LEVEL=WARNING
SECRET_KEY=                              # CHANGE ME (Django SECRET_KEY; generate a 50+ char random string)
JWT_SECRET=                              # CHANGE ME (≥32 char random string for JWT signing)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Who may create the first superadmin.
# cli_only (default) - `manage.py create_superadmin` only; the HTTP
# endpoint is refused. Required for internet-exposed deployments.
# open - POST /api/auth/first-setup/ creates it (local development only).
FIRST_SETUP_MODE=cli_only
LOGIN_THROTTLE_RATE=5/min
DEFAULT_ORGANIZATION_NAME=Organization
PASSWORD_RESET_TOKEN_TTL=900
PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour
# Per-IP cap on POST /api/auth/password-reset/confirm/.
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
# Per-IP cap on POST /api/auth/refresh/.
TOKEN_REFRESH_THROTTLE_RATE=30/min
# SMTP — leave EMAIL_HOST/USER/PASSWORD blank to fall back to the console email backend.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@epicstaff.local
FRONTEND_BASE_URL=http://localhost:4200
FRONTEND_PASSWORD_RESET_PATH=/reset-password
PASSWORD_CHANGE_TICKET_TTL_SECONDS=300
AVATAR_MAX_BYTES=5242880
AVATAR_ALLOWED_FORMATS=JPEG,PNG
# Internal-services system API key (superadmin-equivalent, never expires). Generate a long random string; never share with users.
DJANGO_API_KEY=                          # CHANGE ME (any random string)
ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost,django_app
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
MEDIA_ROOT=/app/media
DJANGO_HOST=localhost
DJANGO_PORT=8000
LOAD_DEBUG_ENV=False
# Memory tuning
MALLOC_ARENA_MAX=2
MALLOC_TRIM_INTERVAL_SECONDS=60

# Gunicorn
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# realtime
DB_REALTIME_USER=realtime_user
DB_REALTIME_PASSWORD=                    # CHANGE ME (postgres role password for realtime service)
REALTIME_PORT=8050
DJANGO_AUTH_URL=http://django_app:8000
DJANGO_AUTH_TIMEOUT=5

# manager
DB_MANAGER_USER=manager_user
DB_MANAGER_PASSWORD=                     # CHANGE ME (postgres role password for manager service)
# CREW_SAVEFILES_PATH must be an absolute host path. Linux/macOS: e.g. /home/<you>/savefiles.
# Windows + Docker Desktop: /c/savefiles. Override per-OS in the install command.
CREW_SAVEFILES_PATH=/c/savefiles
MANAGER_HOST=manager
MANAGER_PORT=8001

# crew
HAYSTACK_TELEMETRY_ENABLED=False
ANONYMIZED_TELEMETRY=False
EC_TELEMETRY=False
MONITORING_MODE=local
DB_CREW_USER=crew_user
DB_CREW_PASSWORD=                        # CHANGE ME (postgres role password for crew service)
MAX_CONCURRENT_SESSIONS=25
# TTL (seconds) for remembered task outputs during flow run
REMEMBERED_OUTPUTS_TTL_S=3600
# RAG search timeouts (seconds)
DEFAULT_RAG_SEARCH_TIMEOUT=40
NAIVE_RAG_SEARCH_TIMEOUT=40
GRAPH_RAG_SEARCH_TIMEOUT=180

# sandbox
BASE_VENV_PATH=/app/src/sandbox/venvs/
OUTPUT_PATH=/app/src/sandbox/executions/
# Replace secret values with [REDACTED] in Python-node output.
# Set false only to debug locally: plaintext credentials then reach
# execution results, the SSE stream and the container logs.
MASK_SECRET=True
CONTAINER_SAVEFILES_PATH=/app/src/sandbox/savefiles/

# knowledge
DB_KNOWLEDGE_USER=knowledge_user
DB_KNOWLEDGE_PASSWORD=                   # CHANGE ME (postgres role password for knowledge service)

# webhook
WEBHOOK_HOST_NAME=webhook
USE_TUNNEL=False
WEBHOOK_TUNNEL=NGROK
# TODO: REMOVE IT GODDAMMIT
WEBHOOK_AUTH=
WEBHOOK_PORT=8009
# Ngrok (only used when USE_TUNNEL=True and WEBHOOK_TUNNEL=NGROK)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# frontend
FRONTEND_PORT=4200
API_URL=http://localhost/api/
REALTIME_API_URL=http://localhost/realtime/

# nginx
DOMAIN_NAME=localhost
# SSL_ENABLE=#  <-- # disables ssl
# SSL_ENABLE=   <-- empty enables ssl
SSL_ENABLE=#

# storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=                      # CHANGE ME (minio secret, ≥8 chars)
STORAGE_BUCKET_NAME=epicstaff
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# agent
AGENT_PORT=8052
AGENT_DEFAULT_MAX_RETRIES=5
# Max tool-use iterations per run (the agent loop)
AGENT_DEFAULT_MAX_ITER=25
# Max re-prompts to make the final answer match output_schema (separate from loop iters)
AGENT_SCHEMA_MAX_RETRIES=2
# Drop LLM params a provider doesn't support (e.g. presence/frequency_penalty on Anthropic) instead of erroring
AGENT_DROP_UNSUPPORTED_LLM_PARAMS=true
# Warn (advisory, in response 'warnings') when input context reaches this fraction of the model's context window; 0 disables
AGENT_CONTEXT_WARNING_RATIO=0.8
AGENT_LOG_LEVEL=INFO
# ==================
